# ==============================================================================
# Website Template Marketplace & Builder - Production Environment Configuration
# Copy this file to .env before deploying: cp .env.production.example .env
# ==============================================================================

# Core Django Security Settings
DEBUG=0
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-production!
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,api.yourdomain.com

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost

# Database Configuration (MySQL 8.0)
DB_ENGINE=mysql
DB_NAME=website_marketplace
DB_USER=marketplace_user
DB_PASSWORD=replace_with_a_secure_database_password
DB_ROOT_PASSWORD=replace_with_a_secure_root_password
DB_HOST=db
DB_PORT=3306

# Payment Gateway Configuration (Stripe / Razorpay)
PAYMENT_GATEWAY_PROVIDER=stripe
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

RAZORPAY_KEY_ID=rzp_live_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Production Email & Password Recovery Delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_or_ses_api_key
DEFAULT_FROM_EMAIL=Website Marketplace <noreply@yourdomain.com>

