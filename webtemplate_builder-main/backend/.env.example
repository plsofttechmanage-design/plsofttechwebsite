# Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-marketplace-secret-key-change-in-production-2026!
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (options: sqlite, mysql)
DB_ENGINE=sqlite

# If DB_ENGINE=mysql:
DB_NAME=website_marketplace
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media and Protected Downloads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_PACKAGE_EXTENSIONS=.zip,.tar.gz,.json

# Payment Gateway (Mock / Razorpay / Stripe)
PAYMENT_GATEWAY_DEFAULT=MOCK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

